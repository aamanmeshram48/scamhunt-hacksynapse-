#!/bin/sh
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec "${JAVA_HOME:-java}" -Dorg.gradle.appname=gradlew -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar:$APP_HOME/gradle/wrapper/gradle-wrapper-shared-9.2.0.jar:$APP_HOME/gradle/wrapper/gradle-cli-9.2.0.jar" org.gradle.wrapper.GradleWrapperMain "$@"
